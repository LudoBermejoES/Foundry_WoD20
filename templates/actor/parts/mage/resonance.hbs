{{!-- add-mage-resonance — task 5.1/5.2: the Resonancia/Sinergia dot-allocator (0-5), one row per
      mark. Reuses the exact `.v3-focusitem`/`.resource-value[data-value]` dot-row markup
      `prism_practices.hbs` established (and this session's own Prácticas dots-bug fix proved
      correct) — `SetupDotCounters_v2` repaints every `.resource-value-step` from the container's
      own `data-value` attribute on every render, so omitting it is exactly the bug that fix caught.
      Always rendered for `splat === mage`, NOT gated on `prismActive`/`hasprismoffocus` — Resonancia
      is a Core-rulebook/Book-of-Secrets optional rule independent of Prism of Focus (design.md D4).
--}}
<h3 class="v3-sectiontitle splatFont">
	{{localize 'wod.resonance.section.title'}}
	{{!-- NOT `class="icon fa-solid fa-square-plus"` — `css/wod.css`'s `.wod20.wod-sheet .icon.
	      fa-square-plus { display: none }` unconditionally hides that exact combo anywhere in
	      the sheet (a rule written for a different, unrelated legacy icon), which is why this
	      header's own add-a-mark affordance was invisible until this fix. The v3 tab's OWN
	      "Añadir objeto" button proves the glyph itself is fine without `.icon` — same pattern
	      here. --}}
	{{!-- polish-mage-sheet-v3-affordances D1 — the add-a-mark control WRITES to the actor, so it is
	      gated on edit mode like every other mutating affordance in this system
	      (`list_icons.hbs:5` is the idiom). It previously had no gate at all, not even a partial
	      one, so a locked sheet offered it. --}}
	{{#if (eq locked false)}}
		<a class="pointer pullRight" data-action="addResonanceMark" title="{{localize 'wod.resonance.dialog.title'}}"><i class="fa-solid fa-square-plus" aria-hidden="true"></i></a>
	{{/if}}
</h3>

<div class="space dialog-area flex-columns" data-drop-area="features" data-droparea="features">
	{{#each resonanceMarks as |row|}}
		<div class="v3-focusitem v3-resonancerow" data-itemid="{{row.item._id}}" style="width:100%;">
			<span class="v3-focuslabel splatFont" title="{{row.item.name}}">
				{{row.item.name}} ({{localize row.flavorLabelKey}})
			</span>

			<div class="resource-value pullLeft"
				data-itemid="{{row.item._id}}"
				data-value="{{row.item.system.value}}"
				data-name="system.value">
				{{#numLoop 5}}
					<span class="resource-value-step {{#if (gte row.item.system.value (add this 1))}}active{{/if}}" data-action="editDot" data-type="{{../config.sheettype.mage}}" data-index="{{this}}" data-itemid="{{row.item._id}}" data-ability="core"></span>
				{{/numLoop}}
			</div>

			{{!-- DELIBERATELY NOT lock-gated (polish-mage-sheet-v3-affordances D1): the eye only
			      opens the read-only description viewer. Hiding it on a locked sheet would remove
			      information from a reader without protecting any data. Same for the Prácticas
			      calculator and the Rituales dialog in the sibling partials. --}}
			<i class="pullRight pointer icon collapsible button fa-solid fa-eye"
				title="{{localize 'wod.labels.show.description'}}"
				data-itemid="{{row.item._id}}"></i>

			{{#if row.item.system.isremovable}}
				{{#if (eq ../locked false)}}
					<a class="pointer item-delete" title="{{localize 'wod.labels.remove.headline'}}" data-itemid="{{row.item._id}}" data-action="itemDelete"><i class="icon fa-solid fa-trash-can"></i></a>
				{{/if}}
			{{/if}}
		</div>
	{{else}}
		<p class="information-area">{{localize 'wod.labels.none'}}</p>
	{{/each}}
</div>
