{{#if showsendchat}}
    <a class="pointer send-chat" title="{{localize 'wod.labels.send'}}" data-itemid="{{item._id}}" data-action="sendChat"><i class="icon fa-solid fa-comment-dots"></i></a>
{{/if}}

{{#if (eq locked false)}} 
    {{#if showedit}}
        <a class="pointer item-edit" title="{{localize edittitle}}" data-type="{{item.type}}" data-itemid="{{item._id}}" data-action="itemEdit"><i class="icon fa-solid fa-pen-to-square"></i></a>
    {{/if}}
    {{#if showdelete}}
        <a class="pointer item-delete" title="{{localize deletetitle}}" data-itemid="{{item._id}}" data-action="itemDelete"><i class="icon fa-solid fa-trash-can"></i></a>
    {{/if}}
{{/if}}

{{!-- The eye always opens the item's own sheet in a window now (open-item-window-from-eye-icon);
      it is no longer gated on whether the item happens to carry description/detail/bonus content -
      see foundry-system-types spec, "Items without descriptions are still clickable". --}}
{{#if showtooltip}}
    <i class="pointer icon collapsible button {{collapseclass}} fa-solid fa-eye"
            title="{{localize 'wod.labels.show.description'}}"
            data-itemid="{{item._id}}"></i>
{{/if}}

<a class="pointer" title="{{localize 'wod.labels.menu'}}" data-itemid="{{item._id}}"><i class="icon fa-solid fa-ellipsis-vertical"></i></a>