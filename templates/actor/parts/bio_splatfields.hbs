
<div style="width: 320px; flex-direction: column;">

    <div class="area-box">

        {{#each splatfields as |field key|}}

            {{#if (eq field.type "input")}}

                <div class="bioInformationArea floating-label-group">
                    {{#if ../locked}}
                        <input class="sheet-infoValues" type="text" value="{{localize field.value}}" autofocus required />
                    {{else}}
                        <input class="sheet-infoValues editable" type="text" name="system.bio.splatfields.{{key}}.value" value="{{localize field.value}}" data-dtype="String" autocomplete="off" autofocus required />
                    {{/if}}
                    {{!-- add-faction-sect-entities — Mage's free-text "Secta" row gets the same eye every
                          other trait on this sheet has, opening the matching `mage-sects` compendium
                          document read-only. `collapsible` is LOAD-BEARING TWICE, same trap as
                          stats_attributes.hbs: `pc-actor-sheet.js`'s binder selects
                          `.collapsible.button[data-traituuid]`, so dropping it kills the click, and
                          `.icon.collapsible.button` is what caps the icon at 20px. Matched by the
                          field's own VALUE (there is no per-row key here), via
                          `sectCompendiumUuid` — see `addBioContext`/`trait-enrichment.js`'s
                          `matchNameDirectly`. Renders nothing for every other splat's/field's input
                          row: `sectCompendiumUuid` is only ever set for `key === "sect"`. --}}
                    {{#if (and (eq key "sect") (lookup ../sectCompendiumUuid field.value))}}
                        <i class="pointer icon collapsible button fa-solid fa-eye wod-namecell-eye"
                            title="{{localize 'wod.labels.show.description'}}"
                            data-traituuid="{{lookup ../sectCompendiumUuid field.value}}"></i>
                    {{/if}}
                    <span class="floating-label">{{localize field.label}}</span>
                </div>

            {{else if (eq field.type "select")}}

                <div class="bioInformationArea floating-label-group {{#if (eq key "generation")}}half{{else}}{{#if (eq field.label "wod.bio.vampire.generation")}}half{{/if}}{{/if}}" data-area="generation">
                    {{#if ../locked}}
                        <input class="sheet-infoValues" type="text" value="{{lookupListData ../listData field.listdata field.value}}" autofocus required />
                    {{else}}
                        <select class="sheet-infoValues editable" name="system.bio.splatfields.{{key}}.value" data-dtype="String">
                            {{selectOptions (lookup ../listData field.listdata) selected=field.value localize=false}}
                        </select>
                    {{/if}}
					<span class="floating-label">{{localize field.label}}</span>
				</div>

                {{#if (eq key "generation")}}
                    <div style="top: -25px; left: 85px; position: relative;">
                        <i class="fa-solid fa-square-minus pointer" title="{{localize 'wod.bio.vampire.lowergeneration'}}" data-action="generationChange" data-source="reduce" data-field-key="{{key}}" aria-hidden="true"></i>
                        <i class="fa-solid fa-eraser pointer" title="{{localize 'wod.bio.vampire.cleargeneration'}}" data-action="generationChange" data-source="clear" data-field-key="{{key}}" aria-hidden="true"></i>
                        {{#if field.mod}}
                            <span>-{{field.mod}}</span>
                        {{/if}}
                    </div>
                {{else}}
                    {{#if (eq field.label "wod.bio.vampire.generation")}}
                    <div style="top: -25px; left: 85px; position: relative;">
                        <i class="fa-solid fa-square-minus pointer" title="{{localize 'wod.bio.vampire.lowergeneration'}}" data-action="generationChange" data-source="reduce" data-field-key="{{key}}" aria-hidden="true"></i>
                        <i class="fa-solid fa-eraser pointer" title="{{localize 'wod.bio.vampire.cleargeneration'}}" data-action="generationChange" data-source="clear" data-field-key="{{key}}" aria-hidden="true"></i>
                        {{#if field.mod}}
                            <span>-{{field.mod}}</span>
                        {{/if}}
                    </div>
                    {{/if}}
                {{/if}}

            {{/if}}

        {{/each}}

    </div>     

</div>