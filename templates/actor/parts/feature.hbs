<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}" data-drop-area="true">

    <i class="macroBtn pointer createicon fa-solid fa-square-plus item-create" title="{{localize "wod.labels.add.item"}}" aria-hidden="true" data-origin="feature" data-action="itemCreate"></i>

    <div class="sheet-area flex-columns">
        <div class="headlineRow headlineList splatFont feature-itemlist">
            <div class="largeBox">{{localize "TYPES.Item.Feature"}}</div>                
        </div>

        {{#if (gt backgrounds.length 0)}}
            <div class="feature-itemlistarea">

                {{#each backgrounds as |item id|}}

                    {{> "systems/worldofdarkness/templates/actor/parts/feature_item.hbs" actor=../actor item=item locked=../locked unnamedtitle="wod.notes.unnamedbackground" edittitle="wod.labels.edit.background" deletetitle="wod.labels.remove.background" showtype=true}}

                {{/each}}

            </div>
        {{/if}}

        {{#if (gt merits.length 0)}}
            <div class="feature-itemlistarea">

                {{#each merits as |item id|}}

                    {{> "systems/worldofdarkness/templates/actor/parts/feature_item.hbs" actor=../actor item=item locked=../locked edittitle="wod.labels.edit.merit" deletetitle="wod.labels.remove.merit" showtype=true}}

                {{/each}}

            </div>
        {{/if}}

        {{#if (gt flaws.length 0)}}
            <div class="feature-itemlistarea">

                {{#each flaws as |item id|}}

                    {{> "systems/worldofdarkness/templates/actor/parts/feature_item.hbs" actor=../actor item=item locked=../locked edittitle="wod.labels.edit.flaw" deletetitle="wod.labels.remove.flaw" showtype=true}}

                {{/each}}

            </div>
        {{/if}}

        {{#if (gt bloodbounds.length 0)}}
            <div class="feature-itemlistarea">

                {{#each bloodbounds as |item id|}}

                    {{> "systems/worldofdarkness/templates/actor/parts/feature_item.hbs" actor=../actor item=item locked=../locked edittitle="wod.labels.edit.bloodbound" deletetitle="wod.labels.remove.bloodbound" showtype=true}}

                {{/each}}

            </div>
        {{/if}}

        {{#if (gt boons.length 0)}}
            <div class="feature-itemlistarea">

                {{#each boons as |item id|}}

                    {{> "systems/worldofdarkness/templates/actor/parts/feature_item.hbs" actor=../actor item=item locked=../locked edittitle="wod.labels.edit.boon" deletetitle="wod.labels.remove.boon" showtype=true}}

                {{/each}}

            </div>
        {{/if}}

        {{#if (gt oaths.length 0)}}
            <div class="feature-itemlistarea">

                {{#each oaths as |item id|}}

                    {{> "systems/worldofdarkness/templates/actor/parts/feature_item.hbs" actor=../actor item=item locked=../locked edittitle="wod.labels.edit.oath" deletetitle="wod.labels.remove.oath" showtype=true}}

                {{/each}}

            </div>
        {{/if}}

        {{!--
            add-wraith-pc-splat §3.6-§3.8 — Passions, Dark Passions and Fetters.

            Three separate blocks, not one: a Passion belongs to the wraith and a Dark Passion to its
            Shadow, and keeping them apart on the sheet is what stops anyone reading them as one pool.

            Each is guarded by its own length check, exactly like every block above, so §3.10 comes for
            free: the EMPTY state — which is the NORMAL state for a freshly imported wraith, since
            wodchar exports neither — renders nothing at all rather than an empty frame. A GM authors
            them with the `data-origin="feature"` create button at the top of this tab (§3.9).

            Fetters carry their description through `feature_item.hbs`'s existing description carrier
            (§3.8): a Fetter is an object, a place or a person, and its rating alone does not say which.
        --}}
        {{#if (gt passions.length 0)}}
            <div class="feature-itemlistarea">

                {{#each passions as |item id|}}

                    {{> "systems/worldofdarkness/templates/actor/parts/feature_item.hbs" actor=../actor item=item locked=../locked edittitle="wod.labels.edit.passion" deletetitle="wod.labels.remove.passion" showtype=true}}

                {{/each}}

            </div>
        {{/if}}

        {{#if (gt darkpassions.length 0)}}
            <div class="feature-itemlistarea">

                {{#each darkpassions as |item id|}}

                    {{> "systems/worldofdarkness/templates/actor/parts/feature_item.hbs" actor=../actor item=item locked=../locked edittitle="wod.labels.edit.darkpassion" deletetitle="wod.labels.remove.darkpassion" showtype=true}}

                {{/each}}

            </div>
        {{/if}}

        {{#if (gt fetters.length 0)}}
            <div class="feature-itemlistarea">

                {{#each fetters as |item id|}}

                    {{> "systems/worldofdarkness/templates/actor/parts/feature_item.hbs" actor=../actor item=item locked=../locked edittitle="wod.labels.edit.fetter" deletetitle="wod.labels.remove.fetter" showtype=true}}

                {{/each}}

            </div>
        {{/if}}

        {{!--
            add-contacts-allies-roster — the relationship roster.

            ONE sub-kind (`wod.types.connection`) grouped by `system.relation`, not one sub-kind per
            Background: the real list is EIGHTEEN people-shaped Backgrounds (design D2/D2a), and a sub-kind
            each would have cost ~500 i18n keys across seven language files for a single concept.

            Each group's heading takes its NAME and its DOTS from the actor's own Background item, so
            "Contactos ●●● (4)" needs no new key and shows the tension between the rating and the headcount
            without enforcing equality — which the books do not require (D1/D4). The whole block is guarded
            on `hasConnections`, so a PC with no entries is untouched (task 3.7), and nothing here is gated
            on `settings.game`: this works for every line (task 3.9).

            The portrait renders `profile-img` + the empty-state class, and `portraitSrc` is resolved in
            the sheet: own image -> linked actor's portrait -> placeholder. That fallback chain works.

            It is NOT a picker, despite what this comment used to claim. There is no `data-edit` on the
            <img> below, so clicking it does nothing: appv1 `DocumentSheet` binds `img[data-edit]`, which
            is why `trait-sheet.html:131` opens a FilePicker and this does not, and the system's only
            FilePicker action (`action-helpers.js OnEditImage`, registered as the actor-sheet `editImage`)
            is hard-wired to `actor.update()` so it could not write an ITEM field even if wired up.
            Set the path or URL on the Feature's own item sheet (`feature-sheet.html`) instead — the
            `wod.connections.portrait` text field there takes both a data-directory path and an absolute
            URL. Measured 2026-08-02. The `pointer` class is gone with the same reasoning: nothing
            happens on click, so the sheet must not offer a hand cursor that says otherwise.

            The RELATIONSHIP DESCRIPTION renders in the row. `feature_item.hbs` emits none — its inline
            panel was removed by `open-item-window-from-eye-icon` — so the row carries its own
            `.connection-description`, fed by `enrichedDescription` off the sheet context. That is
            `resolveDescription` + `enrichHTML`, the same path `item-viewer.js:119-122` uses, so an
            INTERNAL `@UUID[Actor.xxx]{Name}` reference is a clickable anchor HERE and not only in the
            item window. Triple-stash, deliberately: the value is already-enriched HTML.

            The external link copies `bio.hbs:95-104` — anchor when set, localized placeholder when not.

            `.connection-entry` and its children are styled in `css/wod.css` ("START Connection roster"):
            before this row grew a description the class matched NO rule at all, and `shape-image-empty`
            was scoped `.wod20.wod-item` (item sheets only), so the empty state styled nothing on an
            actor sheet. Both are fixed there.
        --}}
        {{#if hasConnections}}
            {{#each connections as |group|}}

                <div class="headlineGroup splatFont">
                    {{group.label}}
                    {{#if group.rating}}{{#numLoop group.rating}}&#9679;{{/numLoop}}{{/if}}
                    ({{group.count}})
                </div>

                <div class="feature-itemlistarea">
                    {{#each group.entries as |item id|}}
                        <div class="sheet-boxcontainer connection-entry">

                            <div class="shape-panel-image connection-portrait">
                                <img class="profile-img shape-image{{#unless item.hasPortrait}} shape-image-empty{{/unless}}"
                                     src="{{item.portraitSrc}}" title="{{item.name}}" />
                            </div>

                            <div class="connection-body">

                                {{> "systems/worldofdarkness/templates/actor/parts/feature_item.hbs"
                                    actor=../../actor item=item locked=../../locked
                                    edittitle="wod.labels.edit.connection"
                                    deletetitle="wod.labels.remove.connection"
                                    showtype=false}}

                                {{#if item.hasDescription}}
                                    <div class="connection-description">{{{item.enrichedDescription}}}</div>
                                {{/if}}

                                {{#if (ne item.system.link "")}}
                                    <a class="connection-link" href="{{item.system.link}}" target="_blank">{{localize 'wod.connections.link'}}</a>
                                {{else}}
                                    <span class="information-area connection-link">{{localize 'wod.connections.nolink'}}</span>
                                {{/if}}

                            </div>

                        </div>
                    {{/each}}
                </div>

            {{/each}}
        {{/if}}

        {{#if (gt shapeforms.length 0)}}
            <div class="feature-itemlistarea">

                {{#each shapeforms as |item id|}}

                    {{> "systems/worldofdarkness/templates/actor/parts/feature_item.hbs" actor=../actor item=item locked=../locked edittitle="wod.labels.edit.headline" deletetitle="wod.labels.remove.headline" showtype=true}}

                {{/each}}

            </div>
        {{/if}}

        {{#if (gt othertraits.length 0)}}
            <div class="feature-itemlistarea">

                {{#each othertraits as |item id|}}

                    {{> "systems/worldofdarkness/templates/actor/parts/feature_item.hbs" actor=../actor item=item locked=../locked edittitle="wod.labels.edit.othertraits" deletetitle="wod.labels.remove.othertraits" showtype=true}}

                {{/each}}

            </div>
        {{/if}}

    </div>        

    <div class="sheet-area flex-columns">
        <div class="clearareaBox area-box">
            <div class="pullLeft" style="width:50%;">
                <div class="headlineRow splatFont">
                    <div class="clearareaBox" style="width:100%">
                        <div class="pullLeft largeBox">{{localize "wod.labels.notes.expearned"}}</div>
                        <div class="pullLeft experienceValue">{{getTotalExperience actor "earned"}}</div>
                        <div class="pullRight pointer" style="margin-right: 15px;">
                            <i class="icon unfold button fa-solid fa-angles-right" title="{{localize 'wod.labels.show.experience'}}" data-sheet="{{config.sheettype.mortal}}" data-type="addexp"></i>
                        </div>                                            
                    </div>
                </div>

                <div class="clearareaBox hide addexp" data-area="addexp">
                    {{#each (getEarnedExperience actor) as |item id|}}
                        <div class="clearareaBox row note-row" style="margin-right: 5px;">
                            <div class="pullLeft notes-experienceHeadline headlineNormal">
                                {{#if (ne item.system.description "")}}
                                    {{item.system.description}}
                                {{else}}
                                    {{localize "wod.notes.descriptionmissing"}}
                                {{/if}}
                            </div>
                            <div class="pullLeft notes-valueBox headlineNormal">{{item.system.amount}}</div>
                            {{#if (eq ../locked false)}}
                                <div class="pullLeft">
                                    <a class="item-edit" title="{{localize 'wod.labels.edit.experience'}}" data-type="Experience" data-itemid="{{item.id}}" data-action="itemEdit"><i class="icon fa-solid fa-pen-to-square"></i></a>
                                    <a class="item-delete" title="{{localize 'wod.labels.remove.experience'}}" data-type="Experience" data-itemid="{{item.id}}" data-action="itemDelete"><i class="icon fa-solid fa-trash-can"></i></a>
                                </div>
                            {{/if}}
                        </div>                    
                    {{/each}}            
                </div>
            </div>

            <div class="pullLeft" style="width:50%">
                <div class="headlineRow splatFont">
                    <div class="clearareaBox" style="width:100%">
                        <div class="pullLeft largeBox">{{localize "wod.labels.notes.expspend"}}</div>
                        <div class="pullLeft experienceValue">{{getTotalExperience actor "spent"}}</div> 
                        <div class="pullRight pointer" style="margin-right: 15px;">
                            <i class="icon unfold button fa-solid fa-angles-right" title="{{localize 'wod.labels.show.spentexp'}}" data-sheet="{{config.sheettype.mortal}}" data-type="spentexp"></i>
                        </div>                                            
                    </div>
                </div>

                <div class="clearareaBox hide spentexp" data-area="spentexp">
                    {{#each (getSpendExperience actor) as |item id|}}
                        <div class="clearareaBox row note-row">
                            <div class="pullLeft notes-experienceHeadline headlineNormal">
                                {{#if (ne item.system.description "")}}
                                    {{item.system.description}}
                                {{else}}
                                    {{localize "wod.notes.descriptionmissing"}}
                                {{/if}}
                            </div>
                            <div class="pullLeft notes-valueBox headlineNormal">
                                {{#if item.system.isspent}}
                                    {{item.system.amount}}
                                {{else}}
                                    {{localize "wod.notes.unspent"}}
                                {{/if}}
                            </div>
                            {{#if (eq ../locked false)}}
                                <div class="pullLeft">
                                    <a class="item-edit" title="{{localize 'wod.labels.edit.experience'}}" data-type="Experience" data-itemid="{{item.id}}" data-action="itemEdit"><i class="icon fa-solid fa-pen-to-square"></i></a>
                                    <a class="item-delete" title="{{localize 'wod.labels.remove.experience'}}" data-type="Experience" data-itemid="{{item.id}}" data-action="itemDelete"><i class="icon fa-solid fa-trash-can"></i></a>
                                </div>
                            {{/if}}
                        </div>
                    {{/each}}
                </div>
            </div>

        </div>
    </div>

</section>