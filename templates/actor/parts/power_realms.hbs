<div class="sheet-area flex-columns">

	<div class="sheet-headline sheet-banner splatFont">
		<span class="sheet-banner-text">{{localize 'wod.realms.headline'}}</span>
	</div>

	<div class="pc-power-realms">
		{{#each realms as |realm index|}}

			{{#if (eq (mod index 3) 0)}}<div class="magic-statArea pullLeft">{{/if}}

			<div class="sphere-itemlist">
				<div class="headlineNormal sphere-itemlist {{#if (eq realm.system.label ../actor.system.bio.splatfields.affinityrealm.value)}}highlightedPowerRow{{/if}}" style="width: 100%;">
					<div class="spheres-headlineWidth headlineNormalSpheres splatFont" 
						{{#if (eq realm.system.label ../actor.system.bio.splatfields.affinityrealm.value)}}
							title="{{localize 'wod.bio.changeling.affinity'}}"
						{{/if}}>
						{{localize realm.system.label}}
					</div>

					<div class="resource-value" 
						data-itemid="{{realm._id}}"
						data-key="{{realm.system.id}}"
						data-value="{{realm.system.value}}" 
						data-name="system.value">

						{{#numLoop realm.system.max}}					
							<span class="resource-value-step" data-action="editDot" data-type="{{../../config.sheettype.mage}}" data-index="{{this}}" data-itemid="{{realm._id}}" data-ability="core"></span>					
						{{/numLoop}}						
						
					</div>
					{{!-- showtooltip=true was missing here, so the eye never rendered and a Realm's
					      rules text (2,100-3,400 chars per Realm, and 6 of 6 live Realms carry it)
					      was unreachable, even though the .description div below has always been
					      present and this include already passed collapseclass="power".

					      The outer `locked` check is KEPT, unlike the flag. 7.5.5 removed it here
					      and in power_spheres.hbs on the reasoning that list_icons.hbs leaves its
					      tooltip outside its own locked gate, i.e. reading should work when locked.
					      That reasoning is sound and the result was still wrong: these two
					      templates are a 3-across dot grid, and rendering an iconBox on a locked
					      sheet where there had never been one consumed the width the FIFTH dot
					      needs, wrapping it onto its own line under every column. Widening the grid
					      is a CSS change with its own blast radius, so the eye is offered on an
					      unlocked sheet only, where this iconBox already existed and already
					      fitted. --}}
					{{#if (eq ../locked false)}}
						<div class="iconBox">
							{{> "systems/worldofdarkness/templates/actor/parts/list_icons.hbs" showedit=true showtooltip=true item=realm locked=../locked edittitle="wod.labels.edit.realm" collapseclass="power"}}
						</div>
					{{/if}}
				</div>

			</div>
			{{!-- The inline .description panel is removed: the eye above now opens the item's
			      own sheet in a window (open-item-window-from-eye-icon). --}}

			{{#if (eq (mod index 3) 2)}}</div>{{/if}}
		
		{{/each}}	
	</div> 

</div>