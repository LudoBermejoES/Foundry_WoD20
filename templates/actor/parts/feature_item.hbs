<div class="item-row-area feature-itemlist">
    <div class="dragrow headlineNormal feature-itemlist" data-itemid="{{item._id}}">
        <div class="width-iconbox draggable"><i class="icon fa-solid fa-grip-vertical"></i></div>

        {{#if (isChecked item.system.isactive)}}
            <i class="item-active pointer icon fa-regular fa-square-check" title="{{localize 'wod.power.active'}}" data-itemid="{{item._id}}" data-type="isactive" data-action="itemActive"></i>
        {{else}}
            <i class="item-active pointer icon fa-regular fa-square" title="{{localize 'wod.power.active'}}" data-itemid="{{item._id}}" data-type="isactive" data-action="itemActive"></i>
        {{/if}}

        
        {{#if item.system.isrollable}}
            <div class="largeBox vrollable" 
                data-rollitem="true" 
                data-itemid="{{item._id}}"
                title="{{item.name}}"
                data-action="rollDice">           
                {{#if (ne item.name "")}}
                    {{item.name}}
                {{else}}
                    {{localize unnamedtitle}}
                {{/if}}
            </div>
        {{else}}
            <div class="largeBox">
                {{#if (ne item.name "")}}
                    {{item.name}}
                {{else}}
                    {{localize unnamedtitle}}
                {{/if}}
            </div>
        {{/if}}

        {{#if showtype}}
        <div class="largeBox">{{localize item.system.type}}</div>
        {{/if}}

        {{#if item.system.isrollable}}
            <div class="width-namebox">{{shorten (localize (getAttributes item.system.dice1)) 10}}</div>
            <div class="width-abilitybox">{{shorten (localize (getAbility item.system.dice2 actor)) 10}}</div>
            <div class="width-valuebox">
                {{#if (eq item.system.difficulty "-1")}}
                    {{localize "wod.labels.varies"}}
                {{else}}
                    {{item.system.difficulty}}
                {{/if}}
            </div>
        {{else}}
            <div class="width-valuebox">
                {{!-- pointValue, not gt: a merit/flaw's point value can be the book's own
                      "1 a 5" / "1 o 3" / "1/2/3/4/5", which gt coerces to NaN and hides.

                      `system.level` FIRST and by default, and `system.value` is NOT read unless the
                      caller opts in with `valuefallback=item.system.value` - deliberately, and this
                      is not the same choice `stats_feature_row.hbs` makes. This partial is shared by
                      twelve blocks across three tabs (merits, flaws, backgrounds, bloodbound, boons,
                      oaths, connections, headlines, other traits, apocalyptic forms, ...) and for
                      several of them `system.value` is not a point cost at all, so a blanket
                      fallback here would start printing a number in a cost column that never had
                      one. An opt-in keeps the blast radius at exactly the callers that ask.

                      The wraith Passion / Dark Passion / Fetter blocks (feature.hbs) are the callers
                      that ask: those three sub-kinds are DOT-RATED traits, not point-costed ones -
                      the exporter writes the rating into `system.value` and hard-codes
                      `level: '0'`, and `pointValue` maps "0" to nothing, which is why the column was
                      blank for every row on the only wraith PC in production. The Death tab renders
                      the same items' `system.value`/`system.max` as filled dots, so the DATA was
                      never the problem - this column was. --}}
                {{#if (pointValue item.system.level valuefallback)}}
                    {{pointValue item.system.level valuefallback}}
                {{else}}
                    &nbsp;
                {{/if}}
            </div>
        {{/if}}
    </div>
    <div class="iconBox">

        {{> "systems/worldofdarkness/templates/actor/parts/list_icons.hbs" showsendchat=true showedit=true showdelete=true showtooltip=true item=item locked=locked edittitle=edittitle deletetitle=deletetitle}}

    </div>	                
</div>
{{!-- The inline .description panel is removed: the eye above now opens the item's own sheet
      in a window (open-item-window-from-eye-icon). --}}