<div class="clearareaBox area-box">
	<div class="sheet-headline sheet-banner splatFont">
		<span class="sheet-banner-text">{{localize 'wod.attributes.attributes'}}</span>
	</div>

	<div class="clearareaBox">
		<div class="attribute-statArea pullLeft headlineGroup splatFont centerText">{{localize 'wod.attributes.physical'}}</div>
		<div class="attribute-statArea pullLeft headlineGroup splatFont centerText">{{localize 'wod.attributes.social'}}</div>
		<div class="attribute-statArea pullLeft headlineGroup splatFont centerText">{{localize 'wod.attributes.mental'}}</div>
	</div>

	<div class="clearareaBox">
		{{#each actor.system.attributes as |attribute key|}}
			{{#if (topAttributes key)}}<div class="attribute-statArea pullLeft">{{/if}}

			{{#if attribute.isvisible}}
				<div class="attribute-rowheight attributes">
					{{#if (and (eq ../actor.system.settings.splat ../config.splat.exalted) (eqAny ../actor.system.settings.variant "lunar" "liminal" "alchemical"))}}
						<div class="pullLeft resource-counter"><input class="item-active pointer resource-value-step" name="attribute.settings.isfavored" type="checkbox" data-type="{{../config.sheettype.exalted}}" data-key="{{key}}" data-attribute="true" {{isChecked attribute.settings.isfavorited}}></input></div>
					{{/if}}

					{{!-- Owner-delegated addition to open-item-window-from-eye-icon: opens a READ-ONLY
					      compendium document for this attribute (never writes to the actor - see
					      attribute-enrichment.js). Only rendered when a match was found at render
					      time (buildAttributeCompendiumUuidMap), so the icon is simply absent - not a
					      dead click - while the compendium's "attributes" pack does not exist yet. A
					      SIBLING of the name label, never a child: the label carries
					      data-action="rollDice" and ApplicationV2 dispatches to the nearest
					      [data-action] ancestor - same invariant stats_feature_row.hbs documents. --}}
					{{!-- The eye and the label share ONE name cell that carries the row's width, instead of
					      both floating left. Floating them side by side is what misaligned this whole
					      block: `ability-headlineWidth` is `width: 50%`, so a `pullLeft` icon in front of
					      it pushed the pair past the row and the label dropped to the next line, taking
					      the dots out of alignment with every other row. The cell keeps
					      `ability-headlineWidth`/`supernaturalAttribute` so the 50%/40% rules apply
					      unchanged; only the label's own float and width move onto it. --}}
					<div class="pullLeft {{#if (gt attribute.max 5)}}supernaturalAttribute{{/if}} ability-headlineWidth wod-namecell">
						{{#if (lookup ../attributeCompendiumUuid key)}}
							{{!-- `collapsible` is LOAD-BEARING TWICE and was dropped once by accident, which
							      broke the click and the layout together: the binder selects
							      `.collapsible.button[data-attributeuuid]` (pc-actor-sheet.js), so without it
							      the eye is dead, and `.icon.collapsible.button` is the rule that caps the
							      icon at 20px — without it `.icon`'s own `line-height: 23px` applies and the
							      icon overflows a 19px row. --}}
							<i class="pointer icon collapsible button fa-solid fa-eye wod-namecell-eye"
								title="{{localize 'wod.labels.show.description'}}"
								data-attributeuuid="{{lookup ../attributeCompendiumUuid key}}"></i>
						{{/if}}
						<label for="data.system.attributes.{{key}}.value"
							class="vrollable headlineNormal wod-namecell-label"
							data-type="{{../config.sheettype.mortal}}"
							data-key="{{key}}"
							data-action="rollDice"
							data-attribute="true">{{localize attribute.label}}</label>
					</div>

					<div class="{{#if (gt attribute.max 8)}}pullLeft{{else}}pullRight{{/if}} resource-value" 
						data-key="{{key}}"
						data-value="{{attribute.value}}" 
						data-name="system.attributes.{{key}}.value">

						{{#if (eqAny ../actor.system.settings.splat ../config.splat.werewolf ../config.splat.changingbreed ../config.splat.demon)}}
							<span class="attribute-total">{{attribute.total}}</span>
						{{/if}}

						{{> "systems/worldofdarkness/templates/actor/parts/stat_value_dots.hbs"
							max=attribute.max
							value=attribute.value
							locked=../locked
							name=(concat "system.attributes." key ".value")
							statKey=key
							dotType=../config.splat.mortal}}
						
						{{#if (gte attribute.value 4)}}
							{{#if (not ../locked)}}
								<div class="{{#if (gt attribute.max 8)}}pullLeft{{else}}pullRight{{/if}} speciality-attribute-icon {{#if (and (eq attribute.speciality '') (gte attribute.value 4))}}item-warning{{/if}}{{#if (ne attribute.speciality '')}}item-notice{{/if}}" data-action="editAttribute">
									<a class="item-edit" title="{{localize 'wod.labels.edit.speciality'}}" data-type="Attribute" data-action="itemEdit" data-itemid="{{key}}"><i class="fa-solid fa-pen-to-square"></i></a>
								</div>
							{{else}}
								<div class="{{#if (gt attribute.max 8)}}pullLeft{{else}}pullRight{{/if}} speciality-attribute-icon" data-type="Attribute" data-action="itemEdit">
									<i class="fa-solid fa-circle-exclamation {{#if (eq attribute.speciality '')}}item-warning{{else}}item-notice{{/if}}" title="{{attribute.speciality}}"></i>
								</div>
							{{/if}}
						{{else}}
							<div class="{{#if (gt attribute.max 8)}}pullLeft{{else}}pullRight{{/if}} speciality-attribute-empty-icon">
								&nbsp;
							</div>
						{{/if}}	

					</div>				
				</div>				
			{{/if}}

			{{#if (bottenAttributes key)}}</div>{{/if}}
		
		{{/each}}	
	</div> 
</div>	