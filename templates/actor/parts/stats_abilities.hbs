<div class="clearareaBox area-box">

	{{#if showheadline}}
		<div class="sheet-headline sheet-banner splatFont">
			<span class="sheet-banner-text">{{localize 'wod.abilities.abilities'}}</span>
		</div>
	{{/if}}

	<div class="clearareaBox">
		<div class="ability-statArea pullLeft headlineGroup splatFont centerText">{{localize 'wod.abilities.talents'}}</div>
		<div class="ability-statArea pullLeft headlineGroup splatFont centerText">{{localize 'wod.abilities.skills'}}</div>
		<div class="ability-statArea pullLeft headlineGroup splatFont centerText">{{localize 'wod.abilities.knowledges'}}</div>
	</div>
	
	<div class="ability-statArea pullLeft">

		{{#if (isEmpty talents)}}
			<div class="centerText headlineNormal">{{localize 'wod.abilities.notalents'}}</div>
		{{/if}}
	
		{{#each talents as |ability key|}}	
			<div class="clearareaBox">
				{{#if (eq ../actor.system.settings.splat ../config.splat.exalted)}}
					<div class="pullLeft resource-counter"><input class="item-active pointer resource-value-step" name="ability.system.settings.isfavored" type="checkbox" data-type="{{../config.sheettype.exalted}}" data-key="{{ability._id}}" data-ability="true" {{isChecked ability.system.settings.isfavorited}}></input></div>
				{{/if}}

				{{!-- The description eye, sharing ONE name cell with the label (open-the-eye-on-abilities).
				      Abilities had no description eye on the stat tab at all: the only one in this file lives
				      inside the `showvisibleicon` block, i.e. the SETTINGS tab, and is further gated on
				      `isremovable` - so a template-seeded primary never had one anywhere, even though
				      v7.5.37 gives it a compendium description to show.

				      The cell, rather than a floated icon, is copied from stats_attributes.hbs and the reason
				      is a measured incident recorded there and in wod.css: `ability-headlineWidth` is
				      `width: 50%`, so a `pullLeft` icon placed in FRONT of it pushes the pair past the row,
				      the label drops to the next line and every dot row below it loses alignment. The label's
				      own float and width therefore move onto the cell; `vrollable`/`headlineNormal`/
				      `secondaryAbility` stay on the label because they style the text, not the box.

				      `data-itemid` (not `data-traituuid`): an ability IS an embedded Item, so it takes the
				      `.collapsible.button[data-itemid]` binder that opens the item's own sheet - the same one
				      stats_feature_row.hbs uses for Backgrounds and Merits. `collapsible` is load-bearing
				      TWICE, and dropping it breaks the click and the layout together: the binder selects on
				      it, and `.icon.collapsible.button` is what caps the icon at 20px in a 19px row.

				      A SIBLING of the label, never a child: the label carries `data-action="rollDice"` and
				      ApplicationV2 dispatches to the nearest `[data-action]` ancestor, so an eye nested inside
				      it would roll the ability on every click. Not gated on `locked` either - reading a
				      description mutates nothing, the same choice the other two blocks already make. --}}
				<div class="pullLeft {{#if (gt ability.system.max 5)}}supernaturalAttribute{{/if}} ability-headlineWidth wod-namecell">
					<i class="pointer icon collapsible button fa-solid fa-eye wod-namecell-eye"
						title="{{localize 'wod.labels.show.description'}}"
						data-itemid="{{ability._id}}"></i>
					<label for="data.system.abilities.{{ability.system.id}}.system.value"
						class="{{#if ../useroll}}vrollable{{/if}} {{#if ability.issecondary}}secondaryAbility{{/if}} headlineNormal wod-namecell-label"
						data-type="{{../config.sheettype.mortal}}"
						data-key="{{ability._id}}"
						{{#if ../useroll}}data-action="rollDice"{{/if}}
						{{!-- A secondary ability sits in the same column as the primary ones (that is the
						      point - it was rendering nowhere before), so the row still has to SAY which
						      one it is. Marked the way the legacy sheets mark it: the `issecondary` flag,
						      here as a class plus the localized type name on hover. data-ability stays
						      "true" - it is what routes the click to the ability branch of
						      ActionHelper.RollDialog, and "secondary" would silently stop the roll. --}}
						{{#if ability.issecondary}}title="{{localize ability.secondarytype}}"{{/if}}
						data-ability="true">
								{{localize ability.system.label}}
					</label>
				</div>

				{{#if ../showvalues}}

					<div class="{{#if (gt ability.system.max 8)}}pullLeft{{else}}pullRight{{/if}} resource-value"  
						data-itemid="{{ability._id}}"
						data-key="{{ability.system.id}}"
						data-value="{{ability.system.value}}" 
						data-name="system.value">

						{{> "systems/worldofdarkness/templates/actor/parts/stat_value_dots.hbs"
							max=ability.system.max
							value=ability.system.value
							locked=../locked
							name="system.value"
							itemid=ability._id
							dotType=../config.sheettype.mortal}}

						{{#if (eq ../locked false)}}
							<div class="{{#if (gt ability.system.max 8)}}pullLeft{{else}}pullRight{{/if}} speciality-ability-icon {{getSpecialityIcon ability}}">
								<a class="item-edit" title="{{localize 'wod.labels.edit.ability'}}" data-type="Ability" data-action="itemEdit" data-itemid="{{ability._id}}"><i class="fa-solid fa-pen-to-square"></i></a>
							</div>
						{{else if (hasSpeciality ability)}}
							<div class="{{#if (gt ability.system.max 8)}}pullLeft{{else}}pullRight{{/if}} speciality-ability-icon">
								<i class="fa-solid fa-circle-exclamation {{getSpecialityIcon ability}}" title="{{ability.system.speciality}}"></i>
							</div>
						{{else}}
							<div class="{{#if (gt ability.system.max 8)}}pullLeft{{else}}pullRight{{/if}} speciality-ability-empty-icon">
								&nbsp;
							</div>
						{{/if}}
						
					</div>	

				{{/if}}
				
				<div>

					{{#if ../showvisibleicon}}					
						{{#if ability.system.settings.isvisible}}
							<i class="item-active pointer icon fa-solid fa-eye" data-itemid="{{ability._id}}" data-type="{{ability.visibilitypath}}" data-action="itemSwitch"></i>
						{{else}}
							<i class="item-active pointer icon fa-solid fa-eye-slash" data-itemid="{{ability._id}}" data-type="{{ability.visibilitypath}}" data-action="itemSwitch"></i>
						{{/if}}
						{{#if ability.system.settings.isremovable}}
							{{!-- showtooltip=true (add-ability-descriptions-from-compendium): Abilities are
						      already embedded Items and now get compendium descriptions, so the eye
						      needs to render here to open them - it was false before because there was
						      never a description to show. Note: this puts two fa-eye icons side by
						      side (the row-visibility toggle above, data-action="itemSwitch", and this
						      one, which opens the item sheet) - a known visual overlap, not fixed here. --}}
						{{> "systems/worldofdarkness/templates/actor/parts/list_icons.hbs" showsendchat=false showedit=false showdelete=true showtooltip=true item=ability locked=../locked edittitle="wod.labels.edit.headline" deletetitle="wod.labels.remove.headline" collapseclass="ability"}}
						{{/if}}
					{{/if}}
				
				</div>
			</div>				
		{{/each}}
	
	</div>

