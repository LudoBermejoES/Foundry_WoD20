<div class="clearareaBox">

	<div class="pullLeft" style="width: 33%;">
		{{#if showVirtues}}		
			{{> "systems/worldofdarkness/templates/actor/parts/stats_virtue.hbs"}}
		{{/if}}
		{{#if showRenowns}}
			{{> "systems/worldofdarkness/templates/actor/parts/stats_renown.hbs"}}
		{{/if}}
		{{#if showQuintessences}}
			{{> "systems/worldofdarkness/templates/actor/parts/stats_quintessence.hbs"}}
		{{/if}}
		{{#if hasGroupedAdvantages}}
			{{> "systems/worldofdarkness/templates/actor/parts/stats_groupedadvantages.hbs"}}
		{{/if}}
		&nbsp;
	</div>

	{{!-- Arete/Willpower and Health used to be two independent 33% columns. They were wrapped in one
	      67% column so a since-removed Rote band could span both of them (that band is gone,
	      reorganize-mage-sheet-v3 D2 — Rotes render on the Poderes tab now); the wrapper stays,
	      because Areté/Willpower and Health are still two 50%-of-this-67% inner columns either way.
	      The Quintessence wheel keeps its own full-height 33% on the left, which is what leaves the
	      empty space this band fills. Inner widths are 50% OF THE WRAPPER, i.e. the same third of
	      the sheet each had. --}}
	<div class="pullLeft" style="width: 67%;">

	<div class="clearareaBox">

	<div class="pullLeft sheet-boxcontainer item-row" style="width: 50%;">

		{{!-- `.wod-pool` is the element that contains exactly ONE advantage. `getGetStatArea_v2` emits
		      the banner and the two dot rows as flat siblings, so until this wrapper existed nothing
		      in the DOM held a single stat and no stylesheet could draw a card round one, or put a
		      label and its dots on one line (add-pc-sheet-v3 D6). All four call sites now use this
		      same pair of classes; they used to use three different wrappers.

		      `sheet-boxcontainer` is NOT decoration here and must not be dropped: this parent is
		      `.item-row`, i.e. `display: flex; flex-wrap: wrap`, so the wrapper is a FLEX ITEM. With
		      `width: auto` it would shrink to its content (~230px, the banner's min-width) inside a
		      ~295px column and the whole block would stop being centred. `sheet-boxcontainer`'s
		      `width: 100%` is exactly what the banner and the two rows each already had, so the
		      wrapper takes one flex line just as they took three, and nothing moves. `.wod-pool`
		      itself carries no rules at all today — it is a handle for the v3 stylesheet.

		      The bloodpool/path `information-area` rows below stay OUTSIDE it: they are per-call-site
		      annotations, not part of the pool the other three sites render. --}}
		{{#each advantages as |advantage id|}}
			<div class="sheet-boxcontainer wod-pool">{{{getGetStatArea_v2 ../actor advantage}}}</div>

			{{#if (eq advantage.system.id "bloodpool")}}
				<div class="information-area centerText">{{localize "wod.advantages.perturn"}}: {{advantage.system.perturn}}</div>
			{{/if}}
			{{#if (eq advantage.system.id "path")}}
				<div class="information-area centerText">
					{{#if ../locked}}
						{{localize "wod.advantages.bearing"}}: {{advantage.system.bearingtext}} ({{../actor.system.advantages.path.system.bearing}})
					{{else}}
						{{localize "wod.advantages.bearing"}}: <input class="sheet-infoValues smallbox inputdata editable" name="system.bearingtext" type="text" value="{{advantage.system.bearingtext}}" data-itemid="{{advantage._id}}" /> ({{../actor.system.advantages.path.system.bearing}})
					{{/if}}
				</div>
			{{/if}}

			{{!-- reorganize-mage-sheet-v3 D8 — CORRECTION to D4: Resonancia y Sinergia is anchored
			      to the Fuerza de Voluntad CARD, not to "the end of the loop". `advantages` is
			      sorted by `system.settings.order`, which is actor data a player can reorder from
			      Ajustes — wodchar's imports give `arete order=0, willpower order=1` so "after the
			      loop" happened to match, but the preflight fixture (and any reordered PC) puts
			      Areté last and would have put Resonancia under ARETÉ instead. Emitting it here,
			      immediately after the card whose `advantage.system.id === "willpower"`, makes the
			      requirement true by construction for either ordering.

			      `resonanceMarks` comes from `addResonanceContext`, called from `prepareStatContext`
			      (`pc-actor-sheet.js`) — the same ApplicationV2 trap as everywhere else in this
			      file: a part only ever sees the context ITS OWN preparer built. `mage/resonance.hbs`
			      reads `resonanceMarks`/`config` as BARE names off whatever context it is handed, so
			      the include must be given an explicit context here — inside `{{#each advantages}}`
			      the bare `this` is `advantage`, not the top-level context, unlike the old
			      OUTSIDE-the-loop position this replaces.

			      GATED TWICE, and both halves matter because this partial is SHARED with v2
			      (`parts/stats.hbs:29` and `v3/stats.hbs:154` both include it):
			        - `splat === mage`, so no other line grows an empty heading in its own advantages
			          column.
			        - `isv3`, so v2 renders NOTHING new here — v2's Stats preparer never calls
			          `addResonanceContext` and never will (out of scope for this change), so without
			          this gate a v2 mage would hit an undefined `resonanceMarks` and either throw or
			          render a broken block. `isv3` is `context.isv3`, set in `pc-actor-sheet.js`'s
			          `stats` case from `this.effectsInSettings` — the one existing per-instance flag
			          that already distinguishes `PCActorSheetV3` (true) from `PCActorSheet` (false).

			      Every name that used to be bare at the top level — `isv3`, `actor`, `config`,
			      `locked`, `resonanceMarks` — is one frame up inside this loop, hence `../` on all
			      five. --}}
			{{#if (eq advantage.system.id "willpower")}}
				{{#if (and ../isv3 (eq ../actor.system.settings.splat ../config.splat.mage))}}
					<div class="v3-resonanceblock">
						{{> "systems/worldofdarkness/templates/actor/parts/mage/resonance.hbs"
							resonanceMarks=../resonanceMarks actor=../actor locked=../locked config=../config}}
					</div>
				{{/if}}
			{{/if}}
		{{/each}}

	</div>

	<div class="healthBox" style="width: 50%; height: 100%; display: flex; flex-direction: column;">

		{{> "systems/worldofdarkness/templates/actor/parts/stats_health.hbs"}}

		<div class="clearareaBox sheet-headline headlineGroup splatFont" style="width: 100%; margin-top: 5px; padding-left: 35px;">
			<div>{{localize 'wod.experience.experience'}}</div>
			<div class="total experienceValue">{{getTotalExperience actor "total"}}</div>
		</div>

	</div>

	</div>

	</div>
</div>