{{!--
  rebuild-chantry-sheet-v2 — the ApplicationV2 replacement for templates/actor/chantry-sheet.html.

  THIS IS THE `traits` PART, not the whole sheet any more (add-chantry-inventory-effects-and-roster,
  task 3.1). `ChantryActorSheetV2` grew three tabs — Rasgos (this file), Efectos
  (`chantry-effects-v2.hbs`) and Equipo (the SHARED `v3/gear.hbs`) — plus the rail
  (`v3/navigation.hbs`). The file KEEPS ITS NAME on purpose: it is the sheet's home tab and its
  content is unchanged bar the roster include, and two preflight gates
  (`test-chantry-trait-eye.mjs`, `test-chantry-trait-order.mjs`) read this path by name. Renaming it
  would have been churn with a gate-shaped cost and no benefit.

  ApplicationV2 IS the `<form>` for this sheet (DocumentSheetV2's default `tag` is "form"), so
  `wod20`/`wod-sheet`/`chantry` (plus whatever the render hook adds -
  `chantry-tradition`/`chantry-technocracy`/`noSplatFont`/`wod-theme-dark`) all land on the SAME
  root element every part's content is inserted into.

  `.locked` therefore MUST be placed on a DESCENDANT of that root, not folded into a compound
  selector on it - `css/wod.css`'s `.wod20.chantry .locked .resource-value-step` rule (and its own
  D3b guard against ever reintroducing `.wod20.chantry.locked` as one compound class) depends on
  `.locked` living on an element BELOW the root, exactly as it did on the appv1 sheet's own
  `<form class="{{cssClass}} ... {{#if locked}}locked{{/if}}">` (a child of the appv1 `.app` root
  carrying the other three classes). The wrapping div below is still that descendant, and it stays
  even though `tab.cssClass` now also carries `locked` — the dots rule depends on THIS div, and
  making it depend on the tab machinery instead would be a silent change to a verified selector.

  THE LOCK CONTROL MOVED, it was not dropped: `navigation_lock.hbs` is now included once by the nav
  rail (`v3/navigation.hbs:46`), the same place the PC sheet has always kept it. Including it here
  as well would render two padlocks on one sheet.
--}}
<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

<div class="chantry-body flexcol {{#if locked}}locked{{/if}}">

	{{!-- Chantry / Construct Sheet Header --}}
	<div class="sheet-character">

		<header class="sheet-header"></header>

		<section class="sheet-body">

			<div class="centerText sheet-headline splatFont">
				{{#if (eq actor.system.flavor "technocracy")}}
					{{localize "wod.chantry.flavors.technocracy"}}
				{{else}}
					{{localize "wod.chantry.flavors.tradition"}}
				{{/if}}
			</div>

			<div class="clearareaBox area-box chantry-top">

				<div class="pullLeft chantry-imgbox">
					<img class="profile-img pointer" src="{{actor.img}}" title="{{actor.name}}" data-edit="img" />
				</div>

				{{!-- `floating-label-group` is the idiom every OTHER floating-label field in this system
				      relies on (`css/wod.css`'s `.floating-label-group` block) for the label's
				      absolute-position anchor and its focus/valid transition - this box never carried it,
				      so the "Nombre" label floated relative to whatever ancestor happened to be
				      positioned instead of this field. Purely additive class; the input/span pair and
				      their own classes are unchanged. --}}
				<div class="pullLeft chantry-namebox floating-label-group">
					{{#if locked}}
						<input class="sheet-infoValues" type="text" value="{{actor.name}}" autocomplete="off" disabled />
					{{else}}
						<input class="sheet-infoValues editable" name="name" type="text" value="{{actor.name}}" data-dtype="String" autocomplete="off" />
					{{/if}}
					<span class="floating-label">{{localize "wod.bio.name"}}</span>
				</div>

			</div>

			{{!-- `chantry-info-box` - additive marker so the four rows below (Tipo/Puntuación/Nivel/
			      Reserva) can be styled as one coherent card (css/wod.css, "Chantry v2 visual polish"),
			      scoped through `.chantry-body` so it can never reach the appv1 sheet, which shares
			      these same bare class names. --}}
			<div class="clearareaBox area-box chantry-info-box">

				<div class="sheet-headline sheet-banner splatFont">
					<span class="sheet-banner-text">{{localize "wod.chantry.headline"}}</span>
				</div>

				<div class="clearareaBox row">
					<div class="pullLeft headlineNormal ability-headlineWidth">{{localize "wod.chantry.flavor"}}</div>
					{{!-- Locked: plain disabled text showing the localized label, not a disabled <select> --
					      existing requirement, unchanged in behaviour from the appv1 sheet. --}}
					{{#if locked}}
						<input class="pullLeft inputdata chantry-locked-value" type="text"
								value="{{localize (concat 'wod.chantry.flavors.' actor.system.flavor)}}" disabled />
					{{else}}
						{{!-- `.editable` is the SAME class `name`/other writable fields on this sheet already
						      carry (`css/wod.css`'s `.wod20 select.editable`/`input.editable` idiom) - this
						      select never had it, which is also why it painted as a plain unstyled browser
						      `<select>` (system default white) in dark mode: nothing but `.locked select` /
						      `select.editable` reaches a `<select>` in `css/darkmode.css`, and this one was
						      neither. Purely additive; `data-source`/`name` and the option list are unchanged. --}}
						<select class="pullLeft inputdata editable" name="system.flavor" data-source="flavor">
							<option value="tradition" {{#if (eq actor.system.flavor "tradition")}}selected{{/if}}>{{localize "wod.chantry.flavors.tradition"}}</option>
							<option value="technocracy" {{#if (eq actor.system.flavor "technocracy")}}selected{{/if}}>{{localize "wod.chantry.flavors.technocracy"}}</option>
						</select>
					{{/if}}
				</div>

				<div class="clearareaBox row">
					<div class="pullLeft headlineNormal ability-headlineWidth">{{localize "wod.chantry.rating"}}</div>
					<div class="pullLeft resource-value chantry-rating" data-value="{{actor.system.rating}}" data-name="rating">
						{{#numLoop 5}}
							<span class="resource-value-step" data-index="{{this}}" {{#if (eq ../locked false)}}data-action="ratingDotChange"{{/if}}></span>
						{{/numLoop}}
					</div>
				</div>

				<div class="clearareaBox row">
					<div class="pullLeft headlineNormal ability-headlineWidth">{{localize "wod.chantry.tier"}}</div>
					{{#if locked}}
						<input class="pullLeft inputdata chantry-locked-value" type="text"
								value="{{localize (concat 'wod.chantry.tiers.' actor.system.tier)}}" disabled />
					{{else}}
						<select class="pullLeft inputdata editable" name="system.tier" data-source="tier">
							{{#each config.chantry.tiers as |tier|}}
								<option value="{{tier}}" {{#if (eq ../actor.system.tier tier)}}selected{{/if}}>{{localize (concat "wod.chantry.tiers." tier)}}</option>
							{{/each}}
						</select>
					{{/if}}
				</div>

				{{!-- `chantry-pool-row` exists only so css/wod.css can free THIS row from the fixed
				      23px `.wod20 .row` height: it is the one row holding a number input, which
				      renders 32px and was being clipped. Additive class, no structural change. --}}
				<div class="clearareaBox row chantry-pool-row">
					<div class="pullLeft headlineNormal ability-headlineWidth">{{localize "wod.chantry.pool"}}</div>

					<div class="pullLeft chantry-pool-total">
						{{localize "wod.chantry.pooltotal"}}:
						<input class="inputdata resource-value-input" type="number" min="0" name="system.pool.total" data-source="pooltotal" value="{{pool.total}}" {{#if locked}}disabled{{/if}} />
					</div>

					<div class="pullLeft chantry-pool-spent">
						{{localize "wod.chantry.poolspent"}}: <span>{{pool.spent}}</span>
					</div>
				</div>

			</div>

			<div class="clearareaBox area-box chantry-traits">

				<div class="sheet-headline sheet-banner splatFont">
					<span class="sheet-banner-text">{{localize "wod.chantry.traitsheadline"}}</span>
				</div>

				{{!-- add-chantry-inventory-effects-and-roster task 3.6 — each Trait is now a BLOCK
				      (the row, plus the roster for the eight Traits that are collections) rather
				      than a bare row. The zebra rule in `css/wod.css` moved with it, from
				      `.chantry-trait-row:nth-of-type(even)` to the block, because `:nth-of-type`
				      counts sibling `<div>`s and interleaving roster divs between rows would have
				      turned a regular band pattern into an irregular one. The row's own markup
				      below is byte-for-byte what it was. --}}
				{{#each listData.traits as |trait|}}
					<div class="chantry-trait-block">
					<div class="clearareaBox row chantry-trait-row" data-key="{{trait.key}}">

						<div class="pullLeft headlineNormal ability-headlineWidth {{#if trait.overcap}}item-warning{{/if}}">{{localize trait.label}}</div>

						<div class="pullLeft resource-value chantry-trait-value" data-value="{{trait.value}}" data-key="{{trait.key}}">
							{{#numLoop 10}}
								<span class="resource-value-step" data-index="{{this}}" {{#if (eq ../../locked false)}}data-action="traitDotChange"{{/if}}></span>
							{{/numLoop}}
						</div>

						<div class="pullLeft chantry-trait-cost">({{trait.cost}} {{localize "wod.chantry.costperdot"}})</div>

						{{!-- The message is a per-Trait KEY (`trait.overcapkey`), not the one literal
						      it used to be: Zona de Realidad caps at the rating ONCE and every other
						      Trait at twice it (design.md D7), so a single "supera el doble" sentence
						      was wrong for exactly the Trait whose cap the book states explicitly. --}}
						{{#if trait.overcap}}
							<div class="pullLeft item-warning chantry-overcap-flag" title="{{localize trait.overcapkey}}">
								<i class="fa-solid fa-triangle-exclamation"></i>
							</div>
						{{/if}}

						{{!-- Read-only: not gated on `locked` (existing requirement) and deliberately outside
						      .chantry-trait-value, so this can never be mistaken for a dot click. Bound
						      unconditionally in _onRender (chantry-actor-sheet-v2.js), not an `actions` entry. --}}
						<i class="pullLeft pointer icon collapsible button fa-solid fa-eye chantry-trait-eye"
								title="{{localize 'wod.labels.show.description'}}"
								data-traitkey="{{trait.key}}"
								data-labelkey="{{trait.label}}"
								data-descriptionkey="{{trait.descriptionkey}}"></i>

						{{!-- LA PUERTA DEL CENSO — el puntero POR RASGO a la pestaña Censo.

						      QUÉ ERA Y QUÉ ES AHORA (add-chantry-roster-tab, D7). En 7.5.137 este icono
						      abría un popup de solo lectura con el censo del Rasgo, porque el censo
						      vivía DENTRO de esta pestaña y no tenía puerta alguna en el estado por
						      defecto: la hoja abre bloqueada, `trait.roster.show` solo era cierto con
						      entradas o desbloqueada, y una Capilla nueva renderizaba 0 bloques, 0
						      controles y 0 caracteres de markup de censo sobre 19 filas de Rasgo, 8 de
						      ellas con censo (frente a 8/8/32 desbloqueada).

						      El censo tiene ahora SU PROPIA PESTAÑA, y el riel se pinta siempre, así que
						      la visibilidad ya no depende de esto. El icono se conserva porque aporta lo
						      que la pestaña no puede: el puntero por Rasgo. Al pulsarlo activa la
						      pestaña Censo y enfoca el grupo de ESTE Rasgo (`_bindTraitRosterButtons`).
						      Y el popup se retira: dos puertas al mismo contenido es justo lo que el
						      cambio anterior evitó a propósito.

						      YA NO VA CONDICIONADO A `trait.roster.show`. Esa condición existía para no
						      ofrecer el censo desde dos sitios a la vez cuando el bloque también se
						      pintaba aquí; el bloque se ha ido (el `{{> chantry_roster.hbs}}` de más
						      abajo ya no existe), así que el icono se renderiza para los ocho Rasgos con
						      censo SIEMPRE — bloqueada o no, con entradas o sin ellas. Sigue sin
						      condicionarse a la puntuación del Rasgo, por la misma razón de siempre: una
						      affordance cuya PRESENCIA depende del dato es la clase de defecto que esto
						      arregla, y `0 / 0` en el tooltip es una lectura verdadera y útil.

						      NO GATEADO POR `locked`: navegar no escribe.

						      NO `data-traitkey` HERE, and it is load-bearing rather than tidy:
						      `_bindTraitDescriptionButtons` binds `.collapsible.button[data-traitkey]` and
						      STAMPS what it binds (`dataset.collapseBound`), so an icon carrying both keys
						      would be claimed by whichever binder ran first and would open the wrong
						      window. The two binders are kept disjoint by attribute, and
						      `test-part-render.mjs` asserts no element carries both. --}}
						{{!-- NO LLEVA `data-traitkey`, y eso es load-bearing y no orden:
						      `_bindTraitDescriptionButtons` liga `.collapsible.button[data-traitkey]` y
						      ESTAMPA lo que liga (`dataset.collapseBound`), así que un icono con las dos
						      claves lo reclamaría la ligadura que corriera primero y abriría la ventana
						      equivocada. Las dos son disjuntas por atributo, y `test-part-render.mjs`
						      comprueba que ningún elemento renderizado lleve las dos.

						      LA RAMA `else` PINTA UN HUECO INVISIBLE, y no es cosmética. La fila es
						      `display:flex` con la etiqueta en `flex: 1 1 auto` absorbiendo el hueco y
						      todo lo demás en `flex: 0 0 auto`, así que una fila con un icono más tiene
						      ~62px más de contenido fijo (52 del icono, 10 del `gap`), su etiqueta
						      absorbe 62px MENOS, y los círculos y el coste se desplazan. Medido sobre la
						      hoja real: los puntos empezaban en x=695 en las ocho filas con censo y en
						      x=758 en las once sin censo.

						      El hueco es el MISMO elemento con las mismas clases de caja, solo oculto,
						      en vez de un `margin-right: 62px`: así el ancho reservado es idéntico por
						      construcción y no hay una constante que se enrancie si el icono cambia de
						      tamaño. Sin `data-rosterkey` no lo engancha el binder, y `pointer-events:
						      none` más `aria-hidden` lo dejan fuera del ratón y del lector de pantalla. --}}
						{{#if trait.roster}}
							<i class="pullLeft pointer icon collapsible button fa-solid fa-list-ul chantry-trait-roster-eye"
									title="{{localize 'wod.chantry.roster.show'}} ({{trait.roster.used}} / {{trait.roster.allowed}})"
									data-rosterkey="{{trait.key}}"
									data-labelkey="{{trait.label}}"></i>
						{{else}}
							<i class="pullLeft icon collapsible button fa-solid fa-list-ul chantry-trait-roster-eye chantry-trait-icon-slot"
									aria-hidden="true"></i>
						{{/if}}

					</div>
					</div>
				{{/each}}

			</div>

			{{!-- add-book-of-chantries-traits (task 5.2) — the six NAMED-LEVEL Traits + wards'
			      defensive add-on. Own box, own control shape (a `<select>` per Trait sized to its
			      own table, never the 2x/1x dot allocator above): design.md D2/D3 say these six are
			      priced by table, never by dots, and never checked against the rating-derived cap
			      at all — mixing them into `.chantry-traits`' `{{#each listData.traits}}` loop would
			      also have widened `CONFIG.worldofdarkness.chantry.traitcost`, which
			      `test-chantry-trait-order.mjs`/`test-chantry-trait-eye.mjs` read directly and which
			      has no per-dot rate to offer for any of these six (design.md D11). --}}
			<div class="clearareaBox area-box chantry-book-traits">

				<div class="sheet-headline sheet-banner splatFont">
					<span class="sheet-banner-text">{{localize "wod.chantry.bookoftraits.headline"}}</span>
				</div>

				{{#each bookTraits as |trait|}}
					<div class="clearareaBox row chantry-book-trait-row" data-key="{{trait.key}}">

						<div class="pullLeft headlineNormal ability-headlineWidth {{#if trait.unpriced}}item-warning{{/if}}">{{localize trait.label}}</div>

						{{#if ../locked}}
							<input class="pullLeft inputdata chantry-locked-value" type="text"
									value="{{localize trait.currentlabelkey}}" disabled />
						{{else}}
							<select class="pullLeft inputdata editable" name="system.traits.{{trait.key}}"
									data-source="booktrait" data-key="{{trait.key}}">
								<option value="" {{#if trait.notbuilt}}selected{{/if}}>{{localize "wod.chantry.bookoftraits.notbuilt"}}</option>
								{{#each trait.options as |option|}}
									<option value="{{option.level}}" {{#if option.selected}}selected{{/if}}>{{localize option.labelkey}}</option>
								{{/each}}
							</select>
						{{/if}}

						{{!-- `wards` alone carries the defensiveLevels add-on: a SEPARATE stepper next
						      to its own select, never a seventh dot/level position on `wards` itself
						      (spec requirement, design.md D8/D12). --}}
						{{#if (eq trait.key "wards")}}
							<div class="pullLeft chantry-wards-defensive" title="{{localize 'wod.chantry.bookoftraits.wardsdefensive.hint'}}">
								<span class="chantry-wards-defensive-label">{{localize "wod.chantry.bookoftraits.wardsdefensive.label"}}:</span>
								{{#if ../locked}}
									<span class="chantry-locked-value">{{../wardsDefensive.value}}</span>
								{{else}}
									<input class="inputdata resource-value-input chantry-wards-defensive-input" type="number" min="0"
											name="system.wardsDefensiveLevels" data-source="wardsdefensive"
											value="{{../wardsDefensive.value}}" />
								{{/if}}
								{{#if ../wardsDefensive.overcap}}
									<i class="pullLeft item-warning fa-solid fa-triangle-exclamation"
											title="{{localize 'wod.chantry.bookoftraits.wardsdefensive.overcap'}}"></i>
								{{/if}}
							</div>
						{{/if}}

					</div>
				{{/each}}

			</div>

			{{!-- add-book-of-chantries-traits (task 5.2) — the Horizon Realm block (design.md D4).
			      The toggle always renders (it is the only way to turn the block on at all); the
			      eight fields + the upkeep figure render ONLY while `realm.hasRealm` is true, per
			      the spec's own requirement ("SHALL render no Realm section at all" otherwise). --}}
			<div class="clearareaBox area-box chantry-realm">

				<div class="sheet-headline sheet-banner splatFont">
					<span class="sheet-banner-text">{{localize "wod.chantry.realm.headline"}}</span>
				</div>

				<div class="clearareaBox row chantry-realm-toggle-row">
					<div class="pullLeft headlineNormal ability-headlineWidth">{{localize "wod.chantry.realm.hasrealm"}}</div>
					{{#if locked}}
						{{#if realm.hasRealm}}
							<span class="chantry-locked-value">{{localize "wod.labels.yes"}}</span>
						{{else}}
							<span class="chantry-locked-value">{{localize "wod.labels.no"}}</span>
						{{/if}}
					{{else}}
						<input type="checkbox" class="editable" name="system.realm.hasRealm" data-source="realmhasrealm"
								{{#if realm.hasRealm}}checked{{/if}} />
					{{/if}}
				</div>

				{{#if realm.hasRealm}}
					<div class="chantry-realm-fields">

						{{!-- The five NAMED-LEVEL fields all share the exact same row shape — only
						      the field/table differ, which `_prepareRealmContext` already resolved
						      server-side onto `realm.<fieldkey>`. Written out explicitly (no loop
						      over a field-name list) because this system's Handlebars runtime has no
						      `array`/`lookup`-into-a-dynamic-key helper registered. --}}
						{{#with realm.size as |field|}}
							<div class="clearareaBox row chantry-realm-field-row" data-field="size">
								<div class="pullLeft headlineNormal ability-headlineWidth">{{localize "wod.chantry.realm.fields.size"}}</div>
								{{#if ../locked}}
									<input class="pullLeft inputdata chantry-locked-value" type="text"
											value="{{localize field.currentlabelkey}}" disabled />
								{{else}}
									<select class="pullLeft inputdata editable" name="system.realm.size"
											data-source="realmfield" data-field="size">
										<option value="" {{#if field.notbuilt}}selected{{/if}}>{{localize "wod.chantry.bookoftraits.notbuilt"}}</option>
										{{#each field.options as |option|}}
											<option value="{{option.level}}" {{#if option.selected}}selected{{/if}}>{{localize option.labelkey}}</option>
										{{/each}}
									</select>
								{{/if}}
							</div>
						{{/with}}

						{{#with realm.terrain as |field|}}
							<div class="clearareaBox row chantry-realm-field-row" data-field="terrain">
								<div class="pullLeft headlineNormal ability-headlineWidth">{{localize "wod.chantry.realm.fields.terrain"}}</div>
								{{#if ../locked}}
									<input class="pullLeft inputdata chantry-locked-value" type="text"
											value="{{localize field.currentlabelkey}}" disabled />
								{{else}}
									<select class="pullLeft inputdata editable" name="system.realm.terrain"
											data-source="realmfield" data-field="terrain">
										<option value="" {{#if field.notbuilt}}selected{{/if}}>{{localize "wod.chantry.bookoftraits.notbuilt"}}</option>
										{{#each field.options as |option|}}
											<option value="{{option.level}}" {{#if option.selected}}selected{{/if}}>{{localize option.labelkey}}</option>
										{{/each}}
									</select>
								{{/if}}
							</div>
						{{/with}}

						{{#with realm.climate as |field|}}
							<div class="clearareaBox row chantry-realm-field-row" data-field="climate">
								<div class="pullLeft headlineNormal ability-headlineWidth">{{localize "wod.chantry.realm.fields.climate"}}</div>
								{{#if ../locked}}
									<input class="pullLeft inputdata chantry-locked-value" type="text"
											value="{{localize field.currentlabelkey}}" disabled />
								{{else}}
									<select class="pullLeft inputdata editable" name="system.realm.climate"
											data-source="realmfield" data-field="climate">
										<option value="" {{#if field.notbuilt}}selected{{/if}}>{{localize "wod.chantry.bookoftraits.notbuilt"}}</option>
										{{#each field.options as |option|}}
											<option value="{{option.level}}" {{#if option.selected}}selected{{/if}}>{{localize option.labelkey}}</option>
										{{/each}}
									</select>
								{{/if}}
							</div>
						{{/with}}

						{{#with realm.population as |field|}}
							<div class="clearareaBox row chantry-realm-field-row" data-field="population">
								<div class="pullLeft headlineNormal ability-headlineWidth">{{localize "wod.chantry.realm.fields.population"}}</div>
								{{#if ../locked}}
									<input class="pullLeft inputdata chantry-locked-value" type="text"
											value="{{localize field.currentlabelkey}}" disabled />
								{{else}}
									<select class="pullLeft inputdata editable" name="system.realm.population"
											data-source="realmfield" data-field="population">
										<option value="" {{#if field.notbuilt}}selected{{/if}}>{{localize "wod.chantry.bookoftraits.notbuilt"}}</option>
										{{#each field.options as |option|}}
											<option value="{{option.level}}" {{#if option.selected}}selected{{/if}}>{{localize option.labelkey}}</option>
										{{/each}}
									</select>
								{{/if}}
							</div>
						{{/with}}

						{{#with realm.socialstructure as |field|}}
							<div class="clearareaBox row chantry-realm-field-row" data-field="socialStructure">
								<div class="pullLeft headlineNormal ability-headlineWidth">{{localize "wod.chantry.realm.fields.socialstructure"}}</div>
								{{#if ../locked}}
									<input class="pullLeft inputdata chantry-locked-value" type="text"
											value="{{localize field.currentlabelkey}}" disabled />
								{{else}}
									<select class="pullLeft inputdata editable" name="system.realm.socialStructure"
											data-source="realmfield" data-field="socialStructure">
										<option value="" {{#if field.notbuilt}}selected{{/if}}>{{localize "wod.chantry.bookoftraits.notbuilt"}}</option>
										{{#each field.options as |option|}}
											<option value="{{option.level}}" {{#if option.selected}}selected{{/if}}>{{localize option.labelkey}}</option>
										{{/each}}
									</select>
								{{/if}}
							</div>
						{{/with}}

						<div class="clearareaBox row chantry-realm-field-row" data-field="interconnected">
							<div class="pullLeft headlineNormal ability-headlineWidth">{{localize "wod.chantry.realm.fields.interconnected"}}</div>
							{{#if locked}}
								{{#if realm.interconnected}}
									<span class="chantry-locked-value">{{localize "wod.labels.yes"}}</span>
								{{else}}
									<span class="chantry-locked-value">{{localize "wod.labels.no"}}</span>
								{{/if}}
							{{else}}
								<input type="checkbox" class="editable" name="system.realm.interconnected"
										data-source="realmfield" data-field="interconnected"
										{{#if realm.interconnected}}checked{{/if}} />
							{{/if}}
						</div>

						<div class="clearareaBox row chantry-realm-field-row" data-field="advancedTransport">
							<div class="pullLeft headlineNormal ability-headlineWidth">{{localize "wod.chantry.realm.fields.advancedtransport"}}</div>
							{{#if locked}}
								{{#if realm.advancedtransport}}
									<span class="chantry-locked-value">{{localize "wod.labels.yes"}}</span>
								{{else}}
									<span class="chantry-locked-value">{{localize "wod.labels.no"}}</span>
								{{/if}}
							{{else}}
								<input type="checkbox" class="editable" name="system.realm.advancedTransport"
										data-source="realmfield" data-field="advancedTransport"
										{{#if realm.advancedtransport}}checked{{/if}} />
							{{/if}}
						</div>

						<div class="chantry-realm-sphereshifts">
							<div class="pullLeft headlineNormal">{{localize "wod.chantry.realm.sphereshift.headline"}}</div>

							{{#if realm.sphereShifts.length}}
								{{#each realm.sphereShifts as |shift|}}
									<div class="clearareaBox row chantry-realm-sphereshift-row" data-index="{{shift.index}}">
										{{#if ../locked}}
											<span class="chantry-locked-value">{{localize (concat "wod.spheres." shift.sphere)}} {{shift.delta}}</span>
										{{else}}
											<select class="inputdata editable" data-source="realmsphereshift" data-index="{{shift.index}}" data-field="sphere">
												{{#each shift.options as |option|}}
													<option value="{{option.key}}" {{#if option.selected}}selected{{/if}}>{{localize option.labelkey}}</option>
												{{/each}}
											</select>
											<input class="inputdata resource-value-input" type="number" data-source="realmsphereshift"
													data-index="{{shift.index}}" data-field="delta" value="{{shift.delta}}"
													title="{{localize 'wod.chantry.realm.sphereshift.delta'}}" />
											<i class="pullLeft pointer icon fa-solid fa-trash chantry-realm-sphereshift-remove"
													data-action="realmSphereShiftDelete" data-index="{{shift.index}}"
													title="{{localize 'wod.chantry.realm.sphereshift.remove'}}"></i>
										{{/if}}
									</div>
								{{/each}}
							{{else}}
								<div class="chantry-realm-sphereshift-empty">{{localize "wod.chantry.realm.sphereshift.empty"}}</div>
							{{/if}}

							{{#unless locked}}
								<i class="pullLeft pointer icon fa-solid fa-plus chantry-realm-sphereshift-add"
										data-action="realmSphereShiftAdd"
										title="{{localize 'wod.chantry.realm.sphereshift.add'}}"></i>
							{{/unless}}
						</div>

						<div class="clearareaBox row chantry-realm-upkeep-row">
							<div class="pullLeft headlineNormal ability-headlineWidth">{{localize "wod.chantry.realm.upkeep"}}</div>
							<div class="pullLeft chantry-realm-upkeep-value">{{realm.upkeep}}</div>
						</div>

					</div>
				{{/if}}

			</div>

			{{!-- add-book-of-chantries-traits (task 5.2) — narrative descriptors: read-only tags,
			      never a dot allocator, never a cost annotation against the pool (design.md D6, spec
			      requirement: "no control that could be mistaken for one that spends points"). The
			      add/remove controls only ATTACH/DETACH an id; neither ever touches
			      `system.pool.spent` — `_computePoolSpent()` has no `descriptors` parameter at all. --}}
			<div class="clearareaBox area-box chantry-descriptors">

				<div class="sheet-headline sheet-banner splatFont">
					<span class="sheet-banner-text">{{localize "wod.chantry.descriptors.headline"}}</span>
				</div>

				<div class="chantry-descriptors-hint">{{localize "wod.chantry.descriptors.hint"}}</div>

				{{#if descriptorTags.length}}
					<div class="chantry-descriptor-tags">
						{{#each descriptorTags as |tag|}}
							<span class="chantry-descriptor-tag" data-id="{{tag.id}}">
								{{#if tag.known}}
									{{localize tag.labelkey}}
									<em class="chantry-descriptor-tag-category">({{localize tag.categorykey}})</em>
								{{else}}
									{{tag.fallbacklabel}}
								{{/if}}
								{{#unless locked}}
									<i class="pointer icon fa-solid fa-xmark chantry-descriptor-tag-remove"
											data-action="descriptorRemove" data-id="{{tag.id}}"
											title="{{localize 'wod.chantry.descriptors.remove'}}"></i>
								{{/unless}}
							</span>
						{{/each}}
					</div>
				{{else}}
					<div class="chantry-descriptors-empty">{{localize "wod.chantry.descriptors.empty"}}</div>
				{{/if}}

				{{#unless locked}}
					{{#if descriptorPicker.length}}
						<div class="chantry-descriptor-picker">
							<select data-descriptorpicker>
								{{#each descriptorPicker as |group|}}
									<optgroup label="{{localize group.categorykey}}">
										{{#each group.options as |option|}}
											<option value="{{option.id}}">{{localize option.labelkey}}</option>
										{{/each}}
									</optgroup>
								{{/each}}
							</select>
							<i class="pointer icon fa-solid fa-plus chantry-descriptor-add"
									data-action="descriptorAdd"
									title="{{localize 'wod.chantry.descriptors.add'}}"></i>
						</div>
					{{/if}}
				{{/unless}}

			</div>

			<div class="clearareaBox area-box chantry-notes">

				<div class="sheet-headline sheet-banner splatFont">
					<span class="sheet-banner-text">{{localize "wod.chantry.notes"}}</span>
				</div>

				{{editor notes target="system.notes" engine="prosemirror" button=false owner=owner editable=(not locked)}}

			</div>

		</section>

	</div>

</div>

</section>
